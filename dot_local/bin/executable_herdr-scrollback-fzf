#!/bin/sh

fallback_editor=${HERDR_SCROLLBACK_FALLBACK_EDITOR:-}
if [ -z "$fallback_editor" ]; then
  if [ -x /opt/homebrew/bin/emacs ]; then
    fallback_editor=/opt/homebrew/bin/emacs
  else
    fallback_editor=emacs
  fi
fi

if [ "$#" -ne 1 ] || [ ! -f "$1" ] || ! command -v fzf >/dev/null 2>&1; then
  exec "$fallback_editor" "$@"
fi

scrollback_file=$1
export HERDR_SCROLLBACK_FILE=$scrollback_file

awk '{ printf "%d\t%s\n", NR, $0 }' "$scrollback_file" |
  fzf --no-sort --tac --layout=default \
    --prompt='scrollback> ' \
    --delimiter='\t' \
    --with-nth=2.. \
    --preview='line={1}; start=$((line-20)); [ "$start" -lt 1 ] && start=1; end=$((line+20)); awk -v start="$start" -v end="$end" -v line="$line" "NR >= start && NR <= end { prefix = sprintf(\"%6d  \", NR); if (NR == line) printf \"\\033[38;5;189;48;5;60m%s%s\\033[0m\\n\", prefix, \$0; else print prefix \$0 }" "$HERDR_SCROLLBACK_FILE"' \
    --preview-window=right:60%:wrap
